<Window x:Class="MegaMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MegaMusic" Height="520" Width="480" MinWidth="380" MinHeight="420"
        Background="#1E1E1E" AllowDrop="True" Drop="Window_Drop" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10,0,20">
            <TextBlock x:Name="TitleText" Text="Drop tracks here" FontSize="22" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="ArtistText" FontSize="15" Foreground="#BBBBBB" TextAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock x:Name="AlbumText" FontSize="13" Foreground="#888888" TextAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="DetailText" FontSize="12" Foreground="#666666" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="1" IsEnabled="False"
                PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"
                ValueChanged="Seek_Changed"/>

        <Grid Grid.Row="2" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PosText" Text="0:00" Foreground="#BBBBBB"/>
                <TextBlock x:Name="DurText" Text="0:00" Foreground="#777777"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevButton" Content="&#9198;" Width="44" Height="34" FontSize="16" Click="Prev_Click"/>
                <Button x:Name="PlayButton" Content="Play" Width="80" Height="34" FontSize="14" Margin="8,0"
                        IsEnabled="False" Click="PlayPause_Click"/>
                <Button x:Name="NextButton" Content="&#9197;" Width="44" Height="34" FontSize="16" Click="Next_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#128266;" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8"
                        VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="ClearButton" Content="Clear queue (Ctrl+Del)" HorizontalAlignment="Right"
                    Padding="8,2" Margin="0,0,0,4" Click="Clear_Click"/>
            <ListBox x:Name="TrackList" Grid.Row="1" Background="#262626" Foreground="White" BorderBrush="#333333"
                     SelectionMode="Extended" MouseDoubleClick="TrackList_DoubleClick" DisplayMemberPath="Display"/>
        </Grid>
    </Grid>
</Window>
